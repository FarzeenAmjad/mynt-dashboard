# Copy this file to .env.local for local development, and set the same
# names in Vercel → Project Settings → Environment Variables for deploys.

# --- Client-side (safe to expose; must be prefixed VITE_ to be bundled) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only (NEVER prefix with VITE_ — that would ship it to the
# browser). Used only by the /api/chat.ts and /api/story.ts Vercel functions. ---
OPENAI_API_KEY=
